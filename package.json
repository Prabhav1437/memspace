{
  "name": "memspace-fs",
  "version": "0.1.0",
  "description": "A Node.js-compatible, zero-disk, in-memory virtual filesystem with isolated instances, memory limits, TTL, snapshots and an Express adapter.",
  "keywords": [
    "fs",
    "filesystem",
    "virtual",
    "in-memory",
    "memfs",
    "vfs",
    "testing",
    "sandbox",
    "express"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prabhav1437/memspace.git"
  },
  "homepage": "https://github.com/Prabhav1437/memspace#readme",
  "bugs": {
    "url": "https://github.com/Prabhav1437/memspace/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc -p tsconfig.examples.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:stress": "vitest run tests/stress",
    "bench": "node --expose-gc benchmarks/run.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run verify:package"
  },
  "peerDependencies": {
    "@types/express": ">=4"
  },
  "peerDependenciesMeta": {
    "@types/express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "express": "^5.3.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
